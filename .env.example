PORT=3000
MONGODB_URI=mongodb://localhost:27017/codepulse
JWT_SECRET=replace_with_strong_secret
JWT_ACCESS_TOKEN_TTL=15m

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/github/oauth/callback
GITHUB_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GITHUB_OAUTH_SCOPES=read:user user:email repo
GITHUB_WEBHOOK_SECRET=
# Public URL GitHub will POST push events to (ngrok / deployed host)
PUBLIC_WEBHOOK_URL=https://your-public-host/api/v1/github/webhook

# Gemini + RAG
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
VECTOR_INDEX_NAME=repo_vectors_index
INDEX_MAX_FILES=500
